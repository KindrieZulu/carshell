@page "/admin/listings/edit"
@{
    ViewData["Title"] = "Vehicle Upload";
    ViewData["ActiveNav"] = "upload";
    Layout = "/Pages/Admin/_AdminLayout.cshtml";
}

<div class="admin-topbar">
    <div>
        <h1 id="page-heading">Vehicle Intake &amp; Inventory Upload Suite</h1>
        <p>Work through each step &mdash; fields marked required must be filled before saving.</p>
    </div>
</div>

<p id="load-error" class="error" hidden style="margin-bottom:1rem;"></p>

<div style="max-width:860px;">
    <div class="stepper" id="stepper">
        <button type="button" class="stepper-step active" data-step="1">
            <span class="stepper-circle">1</span><span class="stepper-label">VIN &amp; Basic ID</span>
        </button>
        <span class="stepper-connector"></span>
        <button type="button" class="stepper-step" data-step="2">
            <span class="stepper-circle">2</span><span class="stepper-label">Powertrain Specs</span>
        </button>
        <span class="stepper-connector"></span>
        <button type="button" class="stepper-step" data-step="3">
            <span class="stepper-circle">3</span><span class="stepper-label">Media Gallery</span>
        </button>
        <span class="stepper-connector"></span>
        <button type="button" class="stepper-step" data-step="4">
            <span class="stepper-circle">4</span><span class="stepper-label">Reserve &amp; Pricing</span>
        </button>
    </div>

    <form id="listing-form">
        <div class="form-card step-panel" data-step-panel="1">
            <h2>Basic Vehicle Registry &amp; VIN Telemetry</h2>
            <div class="form-grid">
                <label>
                    VIN (17 characters, optional)
                    <input type="text" id="vin" maxlength="17" />
                </label>
                <label>
                    Car Reg (optional)
                    <input type="text" id="registration-number" maxlength="20" />
                </label>
                <label>
                    Make
                    <select id="make-id" required></select>
                </label>
                <label>
                    Model
                    <select id="model-id" required></select>
                </label>
                <label>
                    Trim (optional)
                    <input type="text" id="trim" />
                </label>
                <label>
                    Year
                    <input type="number" id="year" min="1950" max="2100" required />
                </label>
                <label>
                    Mileage (km)
                    <input type="number" id="mileage" min="0" required />
                </label>
                <label>
                    Location
                    <div class="combobox" id="suburb-combobox">
                        <input type="text" id="suburb-search" class="combobox-input" autocomplete="off" required
                               placeholder="Search for a city or suburb&hellip;"
                               role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="suburb-panel" />
                        <input type="hidden" id="suburb-id" />
                        <ul class="combobox-panel" id="suburb-panel" role="listbox" hidden></ul>
                    </div>
                </label>
            </div>
        </div>

        <div class="form-card step-panel" data-step-panel="2" hidden>
            <h2>Technical Specifications &amp; Powertrain Architecture</h2>
            <div class="form-grid">
                <label>
                    Engine capacity (litres)
                    <input type="number" id="engine-capacity" min="0.1" max="99.9" step="0.1" required />
                </label>
                <label>
                    Fuel type
                    <select id="fuel-type" required>
                        <option value="Petrol">Petrol</option>
                        <option value="Diesel">Diesel</option>
                        <option value="Electric">Electric</option>
                        <option value="Hybrid">Hybrid</option>
                        <option value="PluginHybrid">Plug-in hybrid</option>
                        <option value="Lpg">LPG</option>
                    </select>
                </label>
                <label>
                    Transmission
                    <select id="transmission" required>
                        <option value="Manual">Manual</option>
                        <option value="Automatic">Automatic</option>
                    </select>
                </label>
                <label>
                    Body type
                    <select id="body-type" required>
                        <option value="Hatchback">Hatchback</option>
                        <option value="Saloon">Saloon</option>
                        <option value="Estate">Estate</option>
                        <option value="Suv">SUV</option>
                        <option value="Coupe">Coupe</option>
                        <option value="Convertible">Convertible</option>
                        <option value="Mpv">MPV</option>
                        <option value="Pickup">Pickup</option>
                    </select>
                </label>
            </div>
        </div>

        <div class="form-card step-panel" data-step-panel="3" hidden id="media-panel">
            <h2>Studio Media &amp; Gallery Assets</h2>
            <div style="display:flex; gap:0.5rem; margin-bottom:1.1rem; flex-wrap:wrap;">
                <span class="badge badge-format">JPEG</span>
                <span class="badge badge-format">PNG</span>
                <span class="badge badge-format">WEBP</span>
                <span class="badge badge-format">Up to 10MB each</span>
            </div>
            <p id="media-locked-message" class="location-status" hidden>Save the basic vehicle details first in steps 1 and 2 &mdash; the media gallery unlocks once this listing exists.</p>
            <div id="images-section" hidden>
                <ul id="image-list"></ul>
                <div class="dropzone">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 16V4m0 0L7 9m5-5l5 5M4 16v3a2 2 0 002 2h12a2 2 0 002-2v-3"/></svg>
                    <p style="margin:0 0 1rem;">Drop photos here, or choose a file</p>
                    <div class="upload-row" style="justify-content:center;">
                        <input type="file" id="image-file" accept="image/jpeg,image/png,image/webp" />
                        <button type="button" id="upload-btn" class="btn btn-ghost btn-sm">Upload</button>
                    </div>
                </div>
                <p id="upload-error" class="error" hidden style="margin-top:0.75rem;"></p>
            </div>
        </div>

        <div class="form-card step-panel" data-step-panel="4" hidden>
            <h2>Pricing Matrix &amp; Approval</h2>
            <div class="form-grid" style="margin-bottom:1.25rem;">
                <label>
                    Price ($)
                    <input type="number" id="price" min="0" required />
                </label>
                <label class="span-2">
                    Description (optional)
                    <textarea id="description" rows="4"></textarea>
                </label>
            </div>

            <div id="status-section" hidden style="margin-bottom:1.25rem; display:flex; flex-direction:column; gap:1rem;">
                <label>
                    Status
                    <select id="status">
                        <option value="Draft">Draft</option>
                        <option value="Active">Active</option>
                        <option value="Sold">Sold</option>
                        <option value="Removed">Removed</option>
                    </select>
                </label>
                <label id="sale-price-label" hidden>
                    Sale price ($)
                    <input type="number" id="sale-price" min="0" />
                </label>
            </div>

            <button type="submit" class="btn-submit-cta" id="submit-btn">Submit for Review &amp; Approval</button>
            <button type="button" id="delete-btn" hidden class="btn btn-danger btn-block" style="margin-top:0.75rem;">Delete listing</button>
            <p id="form-error" class="error" hidden style="margin-top:0.85rem;"></p>
            <p id="form-success" class="success" hidden style="margin-top:0.85rem;"></p>
        </div>
    </form>

    <div class="step-nav">
        <button type="button" class="btn btn-ghost" id="step-back-btn">&larr; Back</button>
        <button type="button" class="btn btn-primary" id="step-next-btn">Continue &rarr;</button>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-upload.js"></script>
}
