@page "/admin/login"
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Admin Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Login - CarShell</title>
    <script src="~/js/theme.js"></script>
    <script>CarShellTheme.init('carshell-admin-theme', 'dark');</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lexend:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="admin-login-shell">
        <main class="admin-login-card">
            <div class="brand-mark-lg"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M17.7 8A7 7 0 1 0 17.7 16" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/><circle cx="17.7" cy="8" r="1.3" fill="#fff"/></svg></div>
            <h1>Welcome back</h1>
            <p class="subtitle">Sign in to manage your CarShell listings.</p>
            <form id="login-form">
                <label>
                    Email or username
                    <input type="text" id="email" required autocomplete="username" />
                </label>
                <label>
                    Password
                    <input type="password" id="password" required autocomplete="current-password" />
                </label>
                <button type="submit" class="btn btn-primary btn-block">Log in</button>
            </form>
            <p id="error" class="error" hidden style="margin-top:1rem;"></p>
            <p style="text-align:center; margin-top:1.5rem;"><a href="/" style="font-size:0.85rem; color:var(--color-ink-muted);">&larr; Back to site</a></p>
        </main>
    </div>

    <script>
        window.CARSHELL_CONFIG = {
            supabaseUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Configuration["Supabase:Url"])),
            anonKey: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Configuration["Supabase:AnonKey"])),
        };
    </script>
    <script src="~/js/admin-auth.js"></script>
    <script>
        document.getElementById('login-form').addEventListener('submit', async (event) => {
            event.preventDefault();
            const errorEl = document.getElementById('error');
            errorEl.hidden = true;
            try {
                const result = await CarShellAdmin.login(
                    document.getElementById('email').value,
                    document.getElementById('password').value);
                if (result.needsCode) {
                    window.location.href = `/admin/mfa-verify?factorId=${encodeURIComponent(result.factorId)}`;
                } else {
                    // No verified authenticator yet — 2FA is mandatory, so
                    // enrollment happens now rather than being optional.
                    window.location.href = '/admin/mfa-setup';
                }
            } catch (err) {
                errorEl.textContent = err.message;
                errorEl.hidden = false;
            }
        });
        window.addEventListener('pageshow', (event) => {
            if (event.persisted) {
                window.location.reload();
            }
        });
    </script>
</body>
</html>
