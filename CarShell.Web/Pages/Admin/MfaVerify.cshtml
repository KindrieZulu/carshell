@page "/admin/mfa-verify"
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Verify your code";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Verify your code - CarShell Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lexend:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="admin-login-shell">
        <main class="admin-login-card">
            <div class="brand-mark-lg"></div>
            <h1>Enter your code</h1>
            <p class="subtitle">Open your authenticator app and enter the current 6-digit code.</p>
            <form id="verify-form">
                <label>
                    6-digit code
                    <input type="text" id="code" inputmode="numeric" pattern="[0-9]*" maxlength="6" autocomplete="one-time-code" required autofocus />
                </label>
                <button type="submit" class="btn btn-primary btn-block">Verify</button>
            </form>
            <p id="error" class="error" hidden style="margin-top:1rem;"></p>
            <p style="text-align:center; margin-top:1.5rem;"><a href="/admin/login" style="font-size:0.85rem; color:var(--color-ink-muted);">&larr; Back to login</a></p>
        </main>
    </div>

    <script>
        window.CARSHELL_CONFIG = {
            supabaseUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Configuration["Supabase:Url"])),
            anonKey: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Configuration["Supabase:AnonKey"])),
        };
    </script>
    <script src="~/js/admin-auth.js"></script>
    <script>
        const params = new URLSearchParams(window.location.search);
        const factorId = params.get('factorId');

        if (!CarShellAdmin.getPendingToken() || !factorId) {
            window.location.href = '/admin/login';
        }

        document.getElementById('verify-form').addEventListener('submit', async (event) => {
            event.preventDefault();
            const errorEl = document.getElementById('error');
            errorEl.hidden = true;
            try {
                await CarShellAdmin.mfaVerify(factorId, document.getElementById('code').value);
                window.location.href = '/admin/listings';
            } catch (err) {
                errorEl.textContent = err.message;
                errorEl.hidden = false;
            }
        });
    </script>
</body>
</html>
