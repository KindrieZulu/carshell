@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - CarShell Admin</title>
    <script src="~/js/theme.js"></script>
    <script>CarShellTheme.init('carshell-admin-theme', 'dark');</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lexend:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="admin-shell">
        <aside class="admin-sidebar">
            <a href="/admin/listings" class="brand"><span class="brand-mark"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M17.7 8A7 7 0 1 0 17.7 16" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/><circle cx="17.7" cy="8" r="1.3" fill="#fff"/></svg></span> CarShell</a>
            <nav class="admin-nav">
                <a href="/admin/listings" class="@(ViewData["ActiveNav"]?.ToString() == "dashboard" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
                    Admin Dashboard
                </a>
                <a href="/admin/listings/edit" class="@(ViewData["ActiveNav"]?.ToString() == "upload" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" d="M12 5v14M5 12h14"/></svg>
                    Upload Car
                </a>
                <a href="/admin/admins" class="@(ViewData["ActiveNav"]?.ToString() == "admins" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path stroke-linecap="round" stroke-linejoin="round" d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
                    Manage Admins
                </a>
            </nav>
            <div class="spacer"></div>
        </aside>
        <div class="admin-content">
            <header class="apex-topbar">
                <div class="apex-topbar-tabs">
                    <a href="/" class="apex-tab" target="_blank" rel="noopener">Public Inventory</a>
                </div>
                <span class="apex-status-pill"><span class="dot"></span> Live</span>
                <button type="button" class="theme-toggle-btn" id="theme-toggle-btn" title="Toggle light/dark theme" aria-label="Toggle light or dark theme">
                    <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4"/><path stroke-linecap="round" d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
                    <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
                </button>
                <div class="apex-avatar-wrap">
                    <button type="button" class="apex-avatar-btn" id="avatar-btn" aria-haspopup="true" aria-expanded="false">&nbsp;</button>
                    <div class="apex-avatar-dropdown" id="avatar-dropdown" hidden>
                        <div class="email" id="avatar-email">Signed in</div>
                        <button type="button" id="logout-btn">Log out</button>
                    </div>
                </div>
            </header>
            <div class="admin-main">
                @RenderBody()
            </div>
        </div>
    </div>

    <script>
        window.CARSHELL_CONFIG = {
            storageBaseUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                $"{Configuration["Supabase:Url"]}/storage/v1/object/public/{Configuration["Supabase:StorageBucket"]}")),
        };
    </script>
    <script src="~/js/admin-auth.js"></script>
    <script src="~/js/site.js"></script>
    <script>
        CarShellAdmin.requireAuth();

        const identity = CarShellAdmin.getIdentity();
        const avatarBtn = document.getElementById('avatar-btn');
        const avatarEmail = document.getElementById('avatar-email');
        if (identity && identity.email) {
            avatarBtn.textContent = identity.email.charAt(0).toUpperCase();
            avatarEmail.textContent = identity.email;
        }

        const avatarDropdown = document.getElementById('avatar-dropdown');
        avatarBtn.addEventListener('click', () => {
            const expanded = avatarBtn.getAttribute('aria-expanded') === 'true';
            avatarBtn.setAttribute('aria-expanded', String(!expanded));
            avatarDropdown.hidden = expanded;
        });
        document.addEventListener('click', (event) => {
            if (!event.target.closest('.apex-avatar-wrap')) {
                avatarDropdown.hidden = true;
                avatarBtn.setAttribute('aria-expanded', 'false');
            }
        });

        document.getElementById('logout-btn').addEventListener('click', () => CarShellAdmin.logout());

        document.getElementById('theme-toggle-btn').addEventListener('click', () => CarShellTheme.toggle('carshell-admin-theme'));

        // A page restored from the browser back/forward cache keeps
        // whatever it last rendered, without re-running requireAuth() --
        // so after a real logout, pressing back then forward could flash
        // this authenticated page again before anything re-checks the
        // session. Forcing a fresh load on restore makes every back/
        // forward navigation here a real reload, same as the server's own
        // Cache-Control: no-store on this route.
        window.addEventListener('pageshow', (event) => {
            if (event.persisted) {
                window.location.reload();
            }
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
