@page
@model CarShell.Web.Pages.IndexModel
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Find a car";
    var storageBaseUrl = $"{Configuration["Supabase:Url"]}/storage/v1/object/public/{Configuration["Supabase:StorageBucket"]}";
}

<section class="hero">
    <div class="container">
        <span class="hero-eyebrow">Zimbabwe&rsquo;s car marketplace</span>
        <h1>Find your next car, right here in Zimbabwe</h1>
        <p class="lede">Browse listings across Harare, Bulawayo and beyond &mdash; filtered by price and distance from wherever you are.</p>
    </div>
</section>

<div class="container">
    <form method="get" class="search-form" id="search-form">
        <div class="filter-dropdown">
            <input type="hidden" name="MakeId" id="make-id-input" value="@Model.MakeId" />
            <button type="button" class="filter-dropdown-toggle" data-filter-toggle="brand-panel">
                <span>@Model.BrandFilterLabel</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="filter-dropdown-panel brand-panel" id="brand-panel" hidden>
                <div class="brand-option-grid">
                    <button type="button" class="brand-option brand-option-all" data-make-id="">All brands</button>
                    @foreach (var makeOption in Model.Makes)
                    {
                        <button type="button" class="brand-option" data-make-id="@makeOption.Id">
                            @if (makeOption.LogoUrl is not null)
                            {
                                <span class="brand-logo-chip"><img src="@makeOption.LogoUrl" alt="" loading="lazy" /></span>
                            }
                            else
                            {
                                <span class="brand-logo-chip brand-logo-fallback">@makeOption.Initials</span>
                            }
                            <span class="brand-option-name">@makeOption.Name</span>
                            <span class="brand-option-count">@makeOption.ListingCount</span>
                        </button>
                    }
                </div>
            </div>
        </div>
        @if (Model.MakeId is not null && Model.AvailableModels.Count > 0)
        {
            <label>
                Model
                <select name="ModelId" id="model-select" onchange="this.form.submit()">
                    <option value="">All @Model.SelectedMakeName models</option>
                    @foreach (var modelOption in Model.AvailableModels)
                    {
                        <option value="@modelOption.Id" selected="@(modelOption.Id == Model.ModelId)">@modelOption.Name (@modelOption.ListingCount)</option>
                    }
                </select>
            </label>
        }

        <div class="filter-dropdown">
            <button type="button" class="filter-dropdown-toggle" data-filter-toggle="price-panel">
                <span>@Model.PriceFilterLabel</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="filter-dropdown-panel" id="price-panel" hidden>
                <label>
                    Min price ($)
                    <input type="number" name="MinPrice" value="@Model.MinPrice" placeholder="0" />
                </label>
                <label>
                    Max price ($)
                    <input type="number" name="MaxPrice" value="@Model.MaxPrice" placeholder="Any" />
                </label>
                <button type="submit" class="btn btn-primary btn-sm btn-block">Apply</button>
            </div>
        </div>

        <div class="filter-dropdown">
            <button type="button" class="filter-dropdown-toggle" data-filter-toggle="mileage-panel">
                <span>@Model.MileageFilterLabel</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="filter-dropdown-panel" id="mileage-panel" hidden>
                <label>
                    Under (km)
                    <input type="number" name="MaxMileage" value="@Model.MaxMileage" placeholder="e.g. 100000" min="0" />
                </label>
                <button type="submit" class="btn btn-primary btn-sm btn-block">Apply</button>
            </div>
        </div>

        <div class="combobox" id="location-combobox">
            <input type="text" name="City" id="location-search" class="combobox-input" autocomplete="off"
                   placeholder="Location" value="@Model.City" aria-label="Location"
                   role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="location-panel" />
            <ul class="combobox-panel" id="location-panel" role="listbox" hidden></ul>
        </div>

        <button type="submit" class="btn btn-primary">Search</button>
    </form>

    <div class="results-heading">
        <h2>@Model.Results.Count @(Model.Results.Count == 1 ? "car" : "cars") found</h2>
        @if (Model.SelectedMakeName is not null)
        {
            <span class="filter-chip">
                @Model.SelectedMakeName
                <a href="@Model.ClearMakeUrl" aria-label="Clear brand filter">&times;</a>
            </span>
        }
        @if (Model.SelectedModelName is not null)
        {
            <span class="filter-chip">
                @Model.SelectedModelName
                <a href="@Model.ClearModelUrl" aria-label="Clear model filter">&times;</a>
            </span>
        }
        @if (Model.SelectedMakeName is null)
        {
            <span>Newest listings first</span>
        }
    </div>

    @if (Model.Results.Count == 0)
    {
        <div class="empty-state card">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13l1.5-5A2 2 0 016.4 6.5h11.2A2 2 0 0119.5 8l1.5 5M5 13h14a1 1 0 011 1v4a1 1 0 01-1 1h-1a1 1 0 01-1-1v-1H7v1a1 1 0 01-1 1H5a1 1 0 01-1-1v-4a1 1 0 011-1z"/><circle cx="7.5" cy="16.5" r="1"/><circle cx="16.5" cy="16.5" r="1"/></svg>
            <p>No cars match your search yet.</p>
        </div>
    }
    else
    {
        <ul class="listing-results">
            @foreach (var listing in Model.Results)
            {
                <li class="tilt">
                    <a href="/listings/@listing.Id" class="listing-card">
                        <div class="tilt-inner">
                            <div class="thumb">
                                <span class="price-tag">$@listing.Price.ToString("N0")</span>
                                @if (listing.CoverImageStorageKey is not null)
                                {
                                    <img src="@($"{storageBaseUrl}/{listing.CoverImageStorageKey}")" alt="" />
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13l1.5-5A2 2 0 016.4 6.5h11.2A2 2 0 0119.5 8l1.5 5M5 13h14a1 1 0 011 1v4a1 1 0 01-1 1h-1a1 1 0 01-1-1v-1H7v1a1 1 0 01-1 1H5a1 1 0 01-1-1v-4a1 1 0 011-1z"/><circle cx="7.5" cy="16.5" r="1"/><circle cx="16.5" cy="16.5" r="1"/></svg>
                                }
                            </div>
                            <div class="body">
                                <span class="title">@listing.Year @listing.Make @listing.Model</span>
                                <span class="meta">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 22s7-7.58 7-12.5A7 7 0 105 9.5C5 14.42 12 22 12 22z"/><circle cx="12" cy="9.5" r="2.25"/></svg>
                                    @listing.Suburb, @listing.City
                                    <span class="meta-sep">&middot;</span>
                                    @listing.Mileage.ToString("N0") km
                                </span>
                            </div>
                        </div>
                    </a>
                </li>
            }
        </ul>
    }
</div>

@section Scripts {
    <script>
        // Brand dropdown: a custom panel of logo chips rather than a native
        // <select>, since <option> elements can't render images. Clicking an
        // entry sets the hidden MakeId field and submits; switching brand
        // also invalidates whatever model was previously picked (a model
        // without its make makes no sense), so that's cleared too rather
        // than round-tripping a stale ModelId.
        document.querySelectorAll('.brand-option').forEach(function (option) {
            option.addEventListener('click', function () {
                var hiddenMakeId = document.getElementById('make-id-input');
                hiddenMakeId.value = option.dataset.makeId;
                var modelSelect = document.getElementById('model-select');
                if (modelSelect) {
                    modelSelect.value = '';
                }
                hiddenMakeId.closest('form').submit();
            });
        });

        // Price / Mileage filter dropdowns: a plain toggle button + panel,
        // same pattern as the old header brand menu. Only one panel open at
        // a time; closes on outside click or Escape.
        (function () {
            var toggles = document.querySelectorAll('[data-filter-toggle]');

            function closeAll(except) {
                toggles.forEach(function (toggle) {
                    var panel = document.getElementById(toggle.dataset.filterToggle);
                    if (panel && panel !== except) {
                        panel.hidden = true;
                        toggle.setAttribute('aria-expanded', 'false');
                    }
                });
            }

            toggles.forEach(function (toggle) {
                var panel = document.getElementById(toggle.dataset.filterToggle);
                if (!panel) return;

                toggle.addEventListener('click', function (event) {
                    event.stopPropagation();
                    var willOpen = panel.hidden;
                    closeAll(willOpen ? panel : null);
                    panel.hidden = !willOpen;
                    toggle.setAttribute('aria-expanded', String(willOpen));
                });
            });

            document.addEventListener('click', function (event) {
                if (!event.target.closest('.filter-dropdown')) {
                    closeAll(null);
                }
            });

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') {
                    closeAll(null);
                }
            });
        })();

        // Location field: a searchable combobox over /api/suburbs/cities --
        // every city and town in Zimbabwe, not the individual suburbs within
        // them. The typed value doubles as the filter value, so there's no
        // separate hidden id field to keep in sync.
        (function () {
            var search = document.getElementById('location-search');
            var panel = document.getElementById('location-panel');
            var combobox = document.getElementById('location-combobox');
            if (!search || !panel || !combobox) return;

            var allCities = [];

            function closePanel() {
                panel.hidden = true;
                panel.replaceChildren();
                search.setAttribute('aria-expanded', 'false');
            }

            function selectCity(city) {
                search.value = city;
                closePanel();
            }

            function renderOptions(filterText) {
                var query = filterText.trim().toLowerCase();
                var matches = query
                    ? allCities.filter(function (c) { return c.toLowerCase().includes(query); })
                    : allCities;

                panel.replaceChildren();

                var anyOption = document.createElement('li');
                anyOption.className = 'combobox-option';
                anyOption.setAttribute('role', 'option');
                anyOption.textContent = 'Any location';
                anyOption.addEventListener('click', function () { selectCity(''); });
                panel.appendChild(anyOption);

                if (matches.length === 0) {
                    var empty = document.createElement('li');
                    empty.className = 'combobox-empty';
                    empty.textContent = 'No matching city or town.';
                    panel.appendChild(empty);
                } else {
                    matches.slice(0, 50).forEach(function (city) {
                        var option = document.createElement('li');
                        option.className = 'combobox-option';
                        option.setAttribute('role', 'option');
                        option.dataset.city = city;
                        option.textContent = city;
                        option.addEventListener('click', function () { selectCity(city); });
                        panel.appendChild(option);
                    });
                }

                panel.hidden = false;
                search.setAttribute('aria-expanded', 'true');
            }

            fetch('/api/suburbs/cities')
                .then(function (response) { return response.json(); })
                .then(function (cities) { allCities = cities; });

            search.addEventListener('focus', function () { renderOptions(search.value); });
            search.addEventListener('input', function () { renderOptions(search.value); });
            search.addEventListener('keydown', function (event) {
                var options = Array.from(panel.querySelectorAll('.combobox-option'));
                if (panel.hidden || options.length === 0) return;
                var activeIndex = options.findIndex(function (o) { return o.classList.contains('active'); });

                if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
                    event.preventDefault();
                    var nextIndex = event.key === 'ArrowDown'
                        ? Math.min(activeIndex + 1, options.length - 1)
                        : Math.max(activeIndex - 1, 0);
                    options.forEach(function (o) { o.classList.remove('active'); });
                    options[nextIndex].classList.add('active');
                    options[nextIndex].scrollIntoView({ block: 'nearest' });
                } else if (event.key === 'Enter') {
                    if (activeIndex >= 0) {
                        event.preventDefault();
                        selectCity(options[activeIndex].dataset.city);
                    }
                } else if (event.key === 'Escape') {
                    closePanel();
                }
            });

            document.addEventListener('click', function (event) {
                if (!combobox.contains(event.target)) {
                    closePanel();
                }
            });
        })();
    </script>
}
