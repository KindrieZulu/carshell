@model IReadOnlyList<CarShell.Web.ViewComponents.BrandMenuItem>

<div class="brand-menu">
    <button type="button" class="brand-menu-toggle" id="brand-menu-toggle" aria-haspopup="true" aria-expanded="false">
        Brands
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"/></svg>
    </button>
    <div class="brand-menu-panel" id="brand-menu-panel" hidden>
        @if (Model.Count == 0)
        {
            <p class="brand-menu-empty">No brands listed yet.</p>
        }
        else
        {
            <a href="/" class="brand-menu-item brand-menu-item-all">All brands</a>
            <div class="brand-menu-grid">
                @foreach (var brand in Model)
                {
                    <a href="/?MakeId=@brand.Id" class="brand-menu-item">
                        @if (brand.LogoUrl is not null)
                        {
                            <span class="brand-logo-chip"><img src="@brand.LogoUrl" alt="" loading="lazy" /></span>
                        }
                        else
                        {
                            <span class="brand-logo-chip brand-logo-fallback">@brand.Initials</span>
                        }
                        <span class="brand-menu-item-name">@brand.Name</span>
                        <span class="brand-menu-count">@brand.ListingCount</span>
                    </a>
                }
            </div>
        }
    </div>
</div>
