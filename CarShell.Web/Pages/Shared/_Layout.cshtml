<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - CarShell</title>
    <script src="~/js/theme.js"></script>
    <script>CarShellTheme.init('carshell-public-theme', 'light');</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lexend:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="site-header">
        <div class="container">
            <a href="/" class="brand"><span class="brand-mark"></span> CarShell</a>
            @await Component.InvokeAsync("BrandMenu")
            <a href="/admin/login" class="admin-link">Admin</a>
            <button type="button" class="theme-toggle-btn" id="theme-toggle-btn" title="Toggle light/dark theme" aria-label="Toggle light or dark theme">
                <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4"/><path stroke-linecap="round" d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
                <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
            </button>
        </div>
    </header>
    <main>
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container">
            <span>&copy; @DateTime.UtcNow.Year CarShell</span>
            <a href="/Privacy">Privacy Policy</a>
        </div>
    </footer>
    <script src="~/js/site.js"></script>
    <script>
        document.getElementById('theme-toggle-btn').addEventListener('click', () => CarShellTheme.toggle('carshell-public-theme'));
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
